---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import AreasServed from '../components/AreasServed.astro';
import aboutPhoto from '../assets/santa-19.jpg';

const promises = [
	{
		title: 'A real beard, truly',
		text: 'No strapping on a costume. Santa Claus Niagara\u2019s whiskers are the genuine article — grown and cared for, because authenticity matters.',
	},
	{
		title: 'Local and dependable',
		text: 'Rooted in the Niagara region, he shows up on time, fully prepared, and ready to give your event his complete attention.',
	},
	{
		title: 'Wonder for every age',
		text: 'From wide-eyed toddlers to grown-ups who still believe, Santa meets each guest exactly where they are with kindness and warmth.',
	},
	{
		title: 'Professional from arrival to goodbye',
		text: 'Every visit is treated as a treasured occasion — polished, punctual, and tailored to the moment you have planned.',
	},
];
---

<Layout
	title="About Santa Claus | Real-Bearded Santa"
	description="Meet Santa Claus Niagara, a real-bearded professional Santa rooted in the Niagara region and available for home visits, holiday parties, and community events."
>
	<section class="relative overflow-hidden bg-pine-950">
		<div class="absolute -top-24 right-0 h-[380px] w-[560px] rounded-full bg-gold-500/15 blur-[110px]"></div>
		<div class="plaid-overlay pointer-events-none absolute inset-0"></div>
		<div class="plaid-banner absolute bottom-0 inset-x-0 h-2"></div>
		<div class="relative mx-auto max-w-5xl px-5 pt-20 pb-24 text-center sm:px-8">
			<p class="eyebrow-light animate-fade-in">About Santa</p>
			<h1 class="mt-4 font-display text-5xl font-semibold text-cream-50 sm:text-6xl animate-fade-up">
				A Life Devoted to <span class="italic text-gold-300">Christmas Joy</span>
			</h1>
			<div class="mx-auto mt-8 flex items-center justify-center gap-4 text-gold-400" aria-hidden="true">
				<span class="h-px w-16 bg-gold-500/50"></span>
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.3 6.8-6-3.4-6 3.4 1.3-6.8L2.2 9.1l6.9-.8L12 2Z" />
				</svg>
				<span class="h-px w-16 bg-gold-500/50"></span>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-5 pt-16 sm:px-8">
		<div class="gold-frame">
			<div class="overflow-hidden rounded-sm">
				<Image
					src={aboutPhoto}
					alt="Santa Claus Niagara out in the community"
					class="aspect-[16/10] w-full object-cover object-center"
				/>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:py-24">
		<div class="space-y-10">
			<div class="flex flex-col items-start gap-6 md:flex-row md:gap-10">
				<span class="shrink-0 font-display text-7xl leading-none font-semibold text-gold-500/70 md:text-8xl">I</span>
				<div>
					<h2 class="font-serif text-2xl font-bold text-pine-900 sm:text-3xl">A calling, not a costume</h2>
					<p class="mt-4 leading-relaxed text-pine-800/80">
						For Santa Claus Niagara, playing Santa has never been a role — it is a
						calling. What began as a love for bringing smiles to the children of his own
						community has grown into a heartfelt tradition shared across the entire
						Niagara region. Year after year, he has walked into living rooms, school
						gyms, hospital wards, and grand celebration halls, carrying the very same
						promise: that Christmas magic is real when it is shared with a genuine heart.
					</p>
				</div>
			</div>

			<div class="flex flex-col items-start gap-6 md:flex-row md:gap-10">
				<span class="shrink-0 font-display text-7xl leading-none font-semibold text-gold-500/70 md:text-8xl">II</span>
				<div>
					<h2 class="font-serif text-2xl font-bold text-pine-900 sm:text-3xl">The real-bearded difference</h2>
					<p class="mt-4 leading-relaxed text-pine-800/80">
						Children know. That careful look, that gentle tug on the whiskers — it is the
						moment a young believer decides, with total certainty, that the guest of
						honour is unmistakably, wonderfully real. Santa Claus Niagara's full, natural
						beard is part of who he is, and it anchors every visit in the authenticity
						that makes the experience unforgettable. There is no thinner line between
						"someone dressed up" and "Santa" — and he has spent a lifetime wearing it.
					</p>
				</div>
			</div>

			<div class="flex flex-col items-start gap-6 md:flex-row md:gap-10">
				<span class="shrink-0 font-display text-7xl leading-none font-semibold text-gold-500/70 md:text-8xl">III</span>
				<div>
					<h2 class="font-serif text-2xl font-bold text-pine-900 sm:text-3xl">Homegrown in Niagara</h2>
					<p class="mt-4 leading-relaxed text-pine-800/80">
						Being local means more than having a nearby address. Santa Claus Niagara knows
						the sweeping views of the Falls, the quiet charm of Niagara-on-the-Lake, and
						the close-knit neighbourhoods of St. Catharines. He understands what makes
						each town feel like home at Christmastime — and he arrives prepared for
						whatever your celebration calls for. Supporting local families and
						organisations is at the very heart of what he does.
					</p>
				</div>
			</div>

			<div class="flex flex-col items-start gap-6 md:flex-row md:gap-10">
				<span class="shrink-0 font-display text-7xl leading-none font-semibold text-gold-500/70 md:text-8xl">IV</span>
				<div>
					<h2 class="font-serif text-2xl font-bold text-pine-900 sm:text-3xl">Joy for children and adults alike</h2>
					<p class="mt-4 leading-relaxed text-pine-800/80">
						The most treasured compliment Santa receives is when the adults in the room
						catch themselves believing too. His visits are equal parts story, laughter,
						and gentle wisdom — he will happily quiz the little ones on their good deeds,
						tell a favourite tale, and give grandparents a moment to revisit the wonder of
						their own childhoods. Christmas, after all, belongs to everyone.
					</p>
				</div>
			</div>
		</div>

		<div class="mt-16 grid gap-6 sm:grid-cols-2">
			{
				promises.map((item) => (
					<div class="tile rounded-sm">
						<div class="flex items-center gap-3">
							<span class="flex h-9 w-9 items-center justify-center rounded-full border border-gold-500/40 bg-gold-500/10 text-gold-700">
								<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M20 6 9 17l-5-5" />
								</svg>
							</span>
							<h3 class="font-serif text-lg font-bold text-pine-900">{item.title}</h3>
						</div>
						<p class="mt-3 text-sm leading-relaxed text-pine-800/75">{item.text}</p>
					</div>
				))
			}
		</div>

		<section class="relative mt-16 overflow-hidden rounded-sm border border-gold-500/40 bg-pine-950 p-10 text-center sm:p-14">
			<div class="plaid-overlay pointer-events-none absolute inset-0"></div>
			<div class="relative">
				<p class="font-display text-3xl leading-snug text-cream-100 italic sm:text-4xl">
					"The greatest gift I can give is a moment children remember for the rest of their lives."
				</p>
				<p class="mt-6 text-xs font-semibold tracking-[0.3em] text-gold-300 uppercase">— Santa Claus Niagara</p>
				<div class="mt-10">
					<a href="/contact/" class="btn btn-gold rounded-sm">Invite Santa to Your Event</a>
				</div>
			</div>
		</section>
	</section>

	<AreasServed
		eyebrow="Where Santa Visits"
		heading="Rooted in Niagara, at home in every community"
		intro="Being local means Santa can be part of Christmas in every corner of the region. Find your community below to learn more about visits nearby."
	/>
</Layout>