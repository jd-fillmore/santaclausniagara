---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Book Santa Claus Niagara — Home Visits, Events & More">
	<section class="relative overflow-hidden bg-pine-950">
		<div class="absolute -top-24 right-1/4 h-[380px] w-[560px] rounded-full bg-gold-500/15 blur-[110px]"></div>
		<div class="plaid-overlay pointer-events-none absolute inset-0"></div>
		<div class="plaid-banner absolute bottom-0 inset-x-0 h-2"></div>
		<div class="relative mx-auto max-w-5xl px-5 pt-20 pb-24 text-center sm:px-8">
			<p class="eyebrow-light animate-fade-in">Contact</p>
			<h1 class="mt-4 font-display text-5xl font-semibold text-cream-50 sm:text-6xl animate-fade-up">
				Let Santa Know <span class="italic text-gold-300">You're Coming</span>
			</h1>
			<p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-cream-100/75 animate-fade-up" style="animation-delay: 0.15s">
				Tell Santa about your event and preferred date. For the fastest answer, call
				directly — but the form below works beautifully too.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-24">
		<div class="grid gap-12 lg:grid-cols-5">
			<div class="lg:col-span-2">
				<p class="eyebrow">Reach Santa Directly</p>
				<h2 class="mt-3 font-serif text-3xl font-bold text-pine-900">
					We love to hear about your plans
				</h2>
				<p class="mt-4 leading-relaxed text-pine-800/80">
					Whether it's a Christmas Eve doorstep visit, a community parade, or a workplace
					celebration, Santa would be delighted to hear from you. Reach out any time to
					check availability and receive a warm, friendly quote.
				</p>

				<div class="mt-8 space-y-4">
					<a href="tel:+19053279036" class="tile group flex items-center gap-4 rounded-sm">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-gold-500/40 bg-gold-500/10 text-gold-700 transition-colors duration-300 group-hover:bg-gold-500 group-hover:text-pine-950">
							<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
								<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 1.9Z" />
							</svg>
						</span>
						<div>
							<p class="text-xs tracking-[0.18em] text-pine-800/60 uppercase">Call Santa</p>
							<p class="font-serif text-xl font-bold text-pine-900">(905) 327-9036</p>
						</div>
					</a>

					<a href="mailto:byauch@cogeco.ca" class="tile group flex items-center gap-4 rounded-sm">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-gold-500/40 bg-gold-500/10 text-gold-700 transition-colors duration-300 group-hover:bg-gold-500 group-hover:text-pine-950">
							<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
								<rect x="2" y="4" width="20" height="16" rx="2" />
								<path d="m22 7-10 6L2 7" />
							</svg>
						</span>
						<div>
							<p class="text-xs tracking-[0.18em] text-pine-800/60 uppercase">Email Santa</p>
							<p class="font-serif text-xl font-bold break-all text-pine-900">byauch@cogeco.ca</p>
						</div>
					</a>

					<div class="tile flex items-center gap-4 rounded-sm">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-gold-500/40 bg-gold-500/10 text-gold-700">
							<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 21c4-4 8-7.3 8-11a8 8 0 1 0-16 0c0 3.7 4 7 8 11Z" />
								<circle cx="12" cy="10" r="2.5" />
							</svg>
						</span>
						<div>
							<p class="text-xs tracking-[0.18em] text-pine-800/60 uppercase">Service Areas</p>
							<p class="font-serif text-xl font-bold text-pine-900">
								Niagara Falls · St. Catharines · NOTL
							</p>
						</div>
					</div>
				</div>

				<div class="mt-6 rounded-sm border-l-2 border-gold-500/60 bg-cream-200/70 p-5">
					<p class="text-[13px] leading-relaxed text-pine-900/85">
						<span class="font-semibold">Rates:</span> $125.00 for the first hour, then
						$50.00 per additional half hour — with travel in St. Catharines, Niagara Falls,
						and Niagara-on-the-Lake included.
					</p>
				</div>

				<div class="mt-4 rounded-sm border-l-2 border-gold-500/60 bg-cream-200/70 p-5">
					<p class="text-[13px] leading-relaxed text-pine-900/85">
						<span class="font-semibold">Travel note:</span> Events outside Niagara Falls,
						St. Catharines, and Niagara-on-the-Lake may include extra travel charges —
						always confirmed with you before booking.
					</p>
				</div>
			</div>

			<div class="lg:col-span-3">
				<form
					name="contact"
					method="POST"
					action="/thank-you/"
					data-netlify="true"
					netlify-honeypot="bot-field"
					class="gold-frame rounded-sm"
				>
					<input type="hidden" name="form-name" value="contact" />
					<input type="hidden" name="Subject" value="New Santa Claus Niagara booking request" />
					<p class="hidden" aria-hidden="true">
						<label>
							Don't fill this out if you're human: <input name="bot-field" />
						</label>
					</p>

					<div class="rounded-sm bg-cream-50 p-7 sm:p-9">
						<h2 class="font-serif text-2xl font-bold text-pine-900 sm:text-3xl">
							Book Santa
						</h2>
						<p class="mt-2 text-sm text-pine-800/70">
							Fill in your details and Santa will get back to you soon.
						</p>

						<div class="mt-8 grid gap-5 sm:grid-cols-2">
							<div>
								<label for="first-name" class="mb-1.5 block text-xs font-semibold tracking-[0.14em] text-pine-900 uppercase">
									First Name
								</label>
								<input
									id="first-name"
									name="First Name"
									type="text"
									required
									autocomplete="given-name"
									placeholder="e.g., Emily"
									class="w-full rounded-sm border border-gold-500/30 bg-cream-100 px-4 py-3 text-sm text-pine-900 placeholder:text-pine-800/40 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25"
								/>
							</div>
							<div>
								<label for="last-name" class="mb-1.5 block text-xs font-semibold tracking-[0.14em] text-pine-900 uppercase">
									Last Name
								</label>
								<input
									id="last-name"
									name="Last Name"
									type="text"
									required
									autocomplete="family-name"
									placeholder="e.g., Carter"
									class="w-full rounded-sm border border-gold-500/30 bg-cream-100 px-4 py-3 text-sm text-pine-900 placeholder:text-pine-800/40 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25"
								/>
							</div>
							<div>
								<label for="email" class="mb-1.5 block text-xs font-semibold tracking-[0.14em] text-pine-900 uppercase">
									Email
								</label>
								<input
									id="email"
									name="Email"
									type="email"
									required
									autocomplete="email"
									placeholder="you@example.com"
									class="w-full rounded-sm border border-gold-500/30 bg-cream-100 px-4 py-3 text-sm text-pine-900 placeholder:text-pine-800/40 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25"
								/>
							</div>
							<div>
								<label for="phone" class="mb-1.5 block text-xs font-semibold tracking-[0.14em] text-pine-900 uppercase">
									Phone
								</label>
								<input
									id="phone"
									name="Phone"
									type="tel"
									autocomplete="tel"
									placeholder="(555) 555-5555"
									class="w-full rounded-sm border border-gold-500/30 bg-cream-100 px-4 py-3 text-sm text-pine-900 placeholder:text-pine-800/40 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25"
								/>
							</div>
							<div class="sm:col-span-2">
								<label for="date" class="mb-1.5 block text-xs font-semibold tracking-[0.14em] text-pine-900 uppercase">
									Requested Date
								</label>
								<input
									id="date"
									name="Requested Date"
									type="date"
									class="w-full rounded-sm border border-gold-500/30 bg-cream-100 px-4 py-3 text-sm text-pine-900 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25"
								/>
							</div>
							<div class="sm:col-span-2">
								<label for="message" class="mb-1.5 block text-xs font-semibold tracking-[0.14em] text-pine-900 uppercase">
									Message
								</label>
								<textarea
									id="message"
									name="Message"
									rows="6"
									required
									placeholder="Tell Santa about your event — the occasion, number of guests, location, and any special wishes..."
									class="w-full resize-y rounded-sm border border-gold-500/30 bg-cream-100 px-4 py-3 text-sm text-pine-900 placeholder:text-pine-800/40 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25"
								></textarea>
							</div>
						</div>

						<button type="submit" class="btn btn-gold mt-8 w-full rounded-sm">
							Send Booking Request
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="22" y1="2" x2="11" y2="13" />
								<polygon points="22 2 15 22 11 13 2 9 22 2" />
							</svg>
						</button>
						<p class="mt-4 text-center text-xs text-pine-800/55">
							Prefer to talk? Call <a href="tel:+19053279036" class="font-semibold text-gold-700">(905) 327-9036</a> — no form required.
						</p>
					</div>
				</form>
			</div>
		</div>
	</section>
</Layout>