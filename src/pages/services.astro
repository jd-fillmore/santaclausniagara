---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import serviceHome from '../assets/santa-11.jpg';
import serviceParty from '../assets/santa-35.jpg';
import serviceCommunity from '../assets/santa-9.jpg';
import servicePhoto from '../assets/santa-40.jpg';
import serviceSchool from '../assets/santa-47.jpg';
import serviceCorporate from '../assets/santa-45.jpg';

const services = [
	{
		id: 'home',
		title: 'Private Home Visits',
		tagline: 'The classic doorstep surprise',
		text: 'The moment Santa steps through your front door, your home becomes the scene of a story your family will tell for years. Perfectly timed for Christmas Eve traditions or a special early visit.',
		details: [
			'A warm, unhurried arrival with time for photos',
			'A visit tailored to your family\u2019s traditions',
			'Time for gifts, storytime, and holiday cheer',
			'Genuine one-on-one moments with every child',
		],
		icon: 'home',
		image: serviceHome,
		feature: 'Best for families creating a lasting Christmas Eve memory, or surprising little ones with an early visit.',
	},
	{
		id: 'party',
		title: 'Holiday Party Entertainment',
		tagline: 'The life of the holiday gathering',
		text: 'Festive, fun, and endlessly engaging — Santa turns any holiday gathering into the event everyone talks about. He mingles naturally with guests of every age, keeping the laughter flowing.',
		details: [
			'Festive interactions for kids and adults',
			'Christmas stories, songs, and gentle fun',
			'Group photos and individual keepsakes',
			'Adapts to the tone of your celebration',
		],
		icon: 'party',
		image: serviceParty,
		feature: 'A warm centerpiece for neighbourhood parties, family reunions, and holiday get-togethers of any size.',
	},
	{
		id: 'community',
		title: 'Community & Charity Events',
		tagline: 'Bringing the whole town together',
		text: 'From holiday parades to charity drives and fundraisers, Santa brings the crowd-pulling charm that makes community events truly shine — while keeping the focus on the cause you care about.',
		details: [
			'Parades, charity drives, and fundraisers',
			'A welcoming presence for all ages',
			'Flexible for on-site or mobile appearances',
			'Happiness that drives generosity and goodwill',
		],
		icon: 'community',
		image: serviceCommunity,
		feature: 'Ideal for community associations, service clubs, churches, and charitable organisations across Niagara.',
	},
	{
		id: 'photo',
		title: 'Photo Sessions & Meet-and-Greets',
		tagline: 'Portrait-perfect holiday memories',
		text: 'Whether at a mall, a photo studio, or a seasonal promotion, Santa poses beautifully and patiently — creating gallery-worthy portraits and unforgettable meet-and-greet experiences.',
		details: [
			'Mall appearances and studio photo sessions',
			'Seasonal promotions and retail events',
			'Professional, patient posing for every shot',
			'Bright, engaging meet-and-greet interactions',
		],
		icon: 'photo',
		image: servicePhoto,
		feature: 'Perfect for photographers, retailers, and venues looking for a polished, photogenic Santa.',
	},
	{
		id: 'school',
		title: 'School & Daycare Visits',
		tagline: 'Storytime with the real St. Nick',
		text: 'There is nothing quite like watching a classroom light up when Santa walks in. He delights young audiences with storytime, photo time, and the kind of gentle magic that little ones carry home.',
		details: [
			'Storytime and sing-alongs for young groups',
			'Individual and class photos',
			'Patient, gentle interactions with every child',
			'Works with teachers and staff on timing',
		],
		icon: 'school',
		image: serviceSchool,
		feature: 'Wonderful for elementary schools, preschools, daycares, and early-learning centres.',
	},
	{
		id: 'corporate',
		title: 'Corporate & Workplace Events',
		tagline: 'Holiday warmth for the team',
		text: 'Give your staff a workplace celebration with real holiday spirit. Santa adds charm to office parties, client gatherings, and staff events — a surprise your team will talk about all season.',
		details: [
			'Staff events, office parties, and client receptions',
			'Photo opportunities for team members and families',
			'Professional and respectful of your environment',
			'Flexible time blocks to fit your agenda',
		],
		icon: 'corporate',
		image: serviceCorporate,
		feature: 'An elegant touch for companies wanting to celebrate their people with genuine holiday cheer.',
	},
];

const iconPaths = {
	home: 'M3 10.5 12 3l9 7.5M5 9.5V21h5v-6h4v6h5V9.5',
	party: 'M8 2v4m8-4v4M4 8h16m-1 0v9a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V8m8 3v3m0 0v4m-2-4h-4a2 2 0 0 1-2-2 4 4 0 0 1 4-4 4 4 0 0 1 4 4 2 2 0 0 1-2 2Z',
	community: 'M4 21v-7a8 8 0 0 1 16 0v7M2 21h20M12 6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
	photo: 'M3 7h4l2-3h6l2 3h4v13H3zM12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
	school: 'M12 3 2 8l10 5 10-5-10-5ZM6 10.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5M22 8v6',
	corporate: 'M5 21V5h14v16M9 21v-8h6v8M9 9h.01M15 9h.01M9 13h.01M15 13h.01M12 12h.01',
};
---

<Layout title="Services | Santa Claus Niagara — Home Visits, Events, Photos & More">
	<section class="relative overflow-hidden bg-pine-950">
		<div class="absolute -top-24 left-0 h-[380px] w-[560px] rounded-full bg-gold-500/15 blur-[110px]"></div>
		<div class="plaid-overlay pointer-events-none absolute inset-0"></div>
		<div class="plaid-banner absolute bottom-0 inset-x-0 h-2"></div>
		<div class="relative mx-auto max-w-5xl px-5 pt-20 pb-24 text-center sm:px-8">
			<p class="eyebrow-light animate-fade-in">Services</p>
			<h1 class="mt-4 font-display text-5xl font-semibold text-cream-50 sm:text-6xl animate-fade-up">
				Ways Santa Can <span class="italic text-gold-300">Visit You</span>
			</h1>
			<p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-cream-100/75 animate-fade-up" style="animation-delay: 0.15s">
				Every appearance is warm, professional, and tailored to the moment you have in
				mind. Explore the ways Santa Claus Niagara can bring magic to your celebration.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-24">
		<div class="space-y-16">
			{
				services.map((service, i) => (
					<article id={service.id} class="scroll-mt-28">
						<div class="grid items-center gap-8 lg:grid-cols-5 lg:gap-12">
							<div class={`lg:col-span-2 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
								<div class="gold-frame">
									<div class="relative flex h-full min-h-[320px] flex-col items-center justify-center overflow-hidden rounded-sm bg-gradient-to-br from-pine-900 via-pine-950 to-mahogany-800 p-10 text-center">
										<Image
											src={service.image}
											alt={`Santa Claus Niagara — ${service.title}`}
											loading="lazy"
											class="absolute inset-0 h-full w-full object-cover object-center opacity-45"
										/>
										<div class="absolute inset-0 bg-gradient-to-br from-pine-950/85 via-pine-950/70 to-mahogany-800/85"></div>
										<svg class="relative h-16 w-16 text-gold-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d={iconPaths[service.icon]} />
										</svg>
										<span class="relative mt-6 font-display text-6xl leading-none font-semibold text-gold-500/50">
											{String(i + 1).padStart(2, '0')}
										</span>
									</div>
								</div>
							</div>

							<div class={`lg:col-span-3 ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
								<p class="eyebrow">{service.tagline}</p>
								<h2 class="mt-3 font-serif text-3xl font-bold text-pine-900 sm:text-4xl">
									{service.title}
								</h2>
								<p class="mt-4 leading-relaxed text-pine-800/80">{service.text}</p>
								<ul class="mt-6 grid gap-3 sm:grid-cols-2">
									{
										service.details.map((detail) => (
											<li class="flex items-start gap-3">
												<svg class="mt-0.5 h-4 w-4 shrink-0 text-gold-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
													<path d="M20 6 9 17l-5-5" />
												</svg>
												<span class="text-sm leading-relaxed text-pine-800/85">{detail}</span>
											</li>
										))
									}
								</ul>
								<p class="mt-6 border-l-2 border-gold-500/60 pl-4 text-sm leading-relaxed text-pine-800/70 italic">
									{service.feature}
								</p>
								<div class="mt-8">
									<a href="/contact/" class="btn btn-gold rounded-sm">
										Book This Visit
									</a>
								</div>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="relative overflow-hidden bg-pine-950 py-16">
		<div class="plaid-overlay pointer-events-none absolute inset-0"></div>
		<div class="absolute -bottom-20 right-10 h-64 w-96 rounded-full bg-gold-500/10 blur-[100px]"></div>
		<div class="relative mx-auto flex max-w-6xl flex-col items-center justify-between gap-8 px-5 text-center sm:px-8 lg:flex-row lg:text-left">
			<div>
				<h2 class="font-serif text-3xl font-bold text-cream-50">Not sure which visit is right?</h2>
				<p class="mt-3 max-w-xl text-sm leading-relaxed text-cream-100/70">
					Visits are <span class="font-semibold text-cream-100">$125.00 for the first hour</span>,{' '}
					then <span class="font-semibold text-cream-100">$50.00 per additional half hour</span>,{' '}
					with travel in St. Catharines, Niagara Falls, and Niagara-on-the-Lake included. Tell
					Santa about your event and he will gladly help you choose the perfect visit.
				</p>
			</div>
			<div class="flex flex-col gap-3 sm:flex-row">
				<a href="/contact/" class="btn btn-gold rounded-sm">Get in Touch</a>
				<a href="/pricing/" class="btn btn-outline-cream rounded-sm">Pricing & Info</a>
			</div>
		</div>
	</section>
</Layout>