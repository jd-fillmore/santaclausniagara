---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Thank You | Santa Claus Niagara"
	description="Thank you for contacting Santa Claus Niagara. Your booking request has been received and Santa will be in touch soon to confirm the details of your visit."
>
	<section class="relative overflow-hidden bg-pine-950">
		<div class="absolute -top-24 left-1/4 h-[380px] w-[560px] rounded-full bg-gold-500/15 blur-[110px]"></div>
		<div class="plaid-overlay pointer-events-none absolute inset-0"></div>
		<div class="plaid-banner absolute bottom-0 inset-x-0 h-2"></div>
		<div class="relative mx-auto max-w-5xl px-5 pt-20 pb-24 text-center sm:px-8">
			<p class="eyebrow-light animate-fade-in">Message Sent</p>
			<h1 class="mt-4 font-display text-5xl font-semibold text-cream-50 sm:text-6xl animate-fade-up">
				Thank You — <span class="italic text-gold-300">Your Wish Is On Its Way</span>
			</h1>
			<p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-cream-100/75 animate-fade-up" style="animation-delay: 0.15s">
				Santa has received your message and will be in touch soon to confirm the details
				of your visit.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-5 py-20 sm:px-8 lg:py-24">
		<div class="gold-frame rounded-sm">
			<div class="rounded-sm bg-cream-50 p-8 text-center sm:p-12">
				<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-gold-500/40 bg-gold-500/10 text-gold-600">
					<svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M20 6 9 17l-5-5" />
					</svg>
				</div>
				<h2 class="mt-6 font-serif text-3xl font-bold text-pine-900">Your request has been received</h2>
				<p class="mx-auto mt-4 max-w-xl leading-relaxed text-pine-800/80">
					Thank you for reaching out to Santa Claus Niagara. Every booking request is read
					personally, and a warm, friendly reply is on its way. If you don't see it soon,
					please check your spam or junk folder.
				</p>

				<div class="mt-8 rounded-sm border-l-2 border-gold-500/60 bg-cream-200/70 p-5 text-left">
					<p class="text-[13px] leading-relaxed text-pine-900/85">
						<span class="font-semibold">Need an answer right away?</span> Call Santa directly
						at <a href="tel:+19053279036" class="font-semibold text-gold-700">(905) 327-9036</a>.
					</p>
				</div>

				<div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
					<a href="/" class="btn btn-gold w-full rounded-sm sm:w-auto">Back to Home</a>
					<a href="/gallery/" class="btn rounded-sm border border-pine-900/20 text-pine-900 hover:-translate-y-0.5 hover:border-gold-500 hover:text-gold-700 sm:w-auto">
						View the Gallery
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
