---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { cities, getCity } from '../../data/cities';
import {
	contact,
	rates,
	ratesSentence,
	pricingExamples,
	money,
	services,
	municipalities,
	localBusinessSchema,
	faqSchema,
} from '../../data/site';

export function getStaticPaths() {
	return cities.map((city) => ({ params: { city: city.slug } }));
}

const city = getCity(Astro.params.city)!;
const others = municipalities.filter((name) => name !== city.name);

const photos = import.meta.glob('../../assets/santa-*.jpg', { eager: true, import: 'default' }) as Record<
	string,
	string
>;
const heroPhoto = photos[`../../assets/${city.photo}`];

const schemas = [localBusinessSchema([city.name]), faqSchema(city.faqs)];
---

<Layout
	title={city.metaTitle}
	description={city.metaDescription}
	schemas={schemas}
>
	<!-- Hero -->
	<section class="relative overflow-hidden bg-pine-950">
		<Image src={heroPhoto} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover object-center opacity-40" />
		<div class="absolute inset-0 bg-gradient-to-b from-pine-950/85 via-pine-900/80 to-pine-950"></div>
		<div class="plaid-overlay pointer-events-none absolute inset-0"></div>
		<div class="absolute -top-32 left-1/2 h-[420px] w-[680px] -translate-x-1/2 rounded-full bg-gold-500/15 blur-[120px]"></div>
		<div class="plaid-banner absolute bottom-0 inset-x-0 h-2"></div>

		<div class="relative mx-auto max-w-5xl px-5 pt-24 pb-28 text-center sm:px-8 lg:pt-28 lg:pb-32">
			<p class="eyebrow-light animate-fade-in inline-flex items-center gap-3">
				<span class="h-px w-10 bg-gold-400/60"></span>
				Real-Bearded Santa · {city.region}
				<span class="h-px w-10 bg-gold-400/60"></span>
			</p>
			<h1 class="mt-6 font-display text-4xl leading-[1.05] font-semibold text-cream-50 sm:text-5xl lg:text-6xl animate-fade-up">
				{city.h1}
			</h1>
			<p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-cream-100/75 sm:text-lg animate-fade-up" style="animation-delay: 0.15s">
				{city.heroIntro}
			</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row animate-fade-up" style="animation-delay: 0.3s">
				<a href="/contact/" class="btn btn-gold rounded-sm">Book Santa</a>
				<a href="/services/" class="btn btn-outline-cream rounded-sm">Explore Services</a>
			</div>
		</div>
	</section>

	<!-- Intro -->
	<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-24">
		<div class="grid items-start gap-12 lg:grid-cols-2">
			<div>
				<p class="eyebrow">A Local Santa</p>
				<h2 class="mt-3 font-serif text-3xl font-bold text-pine-900 sm:text-4xl">
					Christmas across <span class="text-gold-700">{city.name}</span>
				</h2>
				<p class="mt-6 leading-relaxed text-pine-800/80">{city.intro1}</p>
				<p class="mt-4 leading-relaxed text-pine-800/80">{city.intro2}</p>
			</div>
			<div class="tile rounded-sm">
				<p class="eyebrow">At a glance</p>
				<ul class="mt-5 space-y-4">
					{
						city.glance.map((item) => (
							<li class="flex items-start gap-3">
								<svg class="mt-0.5 h-5 w-5 shrink-0 text-gold-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M20 6 9 17l-5-5" />
								</svg>
								<span class="text-sm leading-relaxed font-medium text-pine-900">{item}</span>
							</li>
						))
					}
				</ul>
				<div class="mt-8">
					<a href="/contact/" class="btn btn-gold w-full rounded-sm">Check Your Date</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Visits available -->
	<section class="relative overflow-hidden bg-cream-200/60 py-20 lg:py-24">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<p class="eyebrow">Six Ways to Visit</p>
				<h2 class="mt-3 font-serif text-3xl font-bold text-pine-900 sm:text-4xl">
					Visits available in {city.name}
				</h2>
			</div>
			<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					services.map((service, i) => (
						<div class="tile flex flex-col rounded-sm">
							<h3 class="font-serif text-xl font-bold text-pine-900">
								<a href={service.anchor} class="transition-colors hover:text-gold-700">
									{service.title} in {city.name}
								</a>
							</h3>
							<p class="mt-3 flex-1 text-sm leading-relaxed text-pine-800/75">{city.services[i]}</p>
							<a
								href={service.anchor}
								class="mt-5 inline-flex items-center gap-2 text-xs font-semibold tracking-[0.16em] text-gold-700 uppercase transition-colors hover:text-gold-600"
							>
								Learn More
								<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<line x1="5" y1="12" x2="19" y2="12" />
									<polyline points="12 5 19 12 12 19" />
								</svg>
							</a>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Pricing -->
	<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-24">
		<div class="mx-auto max-w-3xl">
			<div class="gold-frame">
				<div class="relative overflow-hidden rounded-sm bg-pine-950 p-8 text-center sm:p-12">
					<div class="plaid-overlay pointer-events-none absolute inset-0"></div>
					<div class="relative">
						<p class="eyebrow-light">Pricing for {city.name}</p>
						<h2 class="mt-3 font-serif text-3xl font-bold text-cream-50 sm:text-4xl">
							Simple, friendly rates
						</h2>
						<div class="mt-9 flex flex-col items-center justify-center gap-8 sm:flex-row sm:gap-14">
							<div>
								<p class="font-display text-6xl leading-none font-semibold text-gold-400">{money(rates.firstHour).replace('.00', '')}</p>
								<p class="mt-3 text-xs font-semibold tracking-[0.2em] text-cream-100/70 uppercase">First hour</p>
							</div>
							<div class="hidden h-20 w-px bg-gold-500/30 sm:block"></div>
							<div>
								<p class="font-display text-6xl leading-none font-semibold text-gold-400">{money(rates.additionalHalfHour).replace('.00', '')}</p>
								<p class="mt-3 text-xs font-semibold tracking-[0.2em] text-cream-100/70 uppercase">Each additional ½ hour</p>
							</div>
						</div>
						<p class="mx-auto mt-9 max-w-xl text-sm leading-relaxed text-cream-100/75">
							{ratesSentence} {city.pricingNote}
						</p>

						<div class="mx-auto mt-9 grid max-w-xl gap-3 sm:grid-cols-3">
							{
								pricingExamples.map((example) => (
									<div class="rounded-sm border border-gold-500/25 bg-pine-900/50 p-4">
										<p class="font-display text-2xl font-semibold text-gold-400">{money(example.price)}</p>
										<p class="mt-1 text-[11px] font-semibold tracking-[0.16em] text-cream-100/60 uppercase">{example.duration}</p>
									</div>
								))
							}
						</div>
						<p class="mt-4 text-xs text-cream-100/50">Example totals only. Santa will confirm your exact total before booking.</p>

						<div class="mt-9">
							<a href="/contact/" class="btn btn-gold rounded-sm">Request a Quote</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- How booking works -->
	<section class="mx-auto max-w-7xl px-5 pb-4 sm:px-8 lg:pb-8">
		<div class="mx-auto max-w-2xl text-center">
			<p class="eyebrow">How Booking Works</p>
			<h2 class="mt-3 font-serif text-3xl font-bold text-pine-900 sm:text-4xl">
				Three simple steps
			</h2>
		</div>
		<div class="mx-auto mt-14 grid max-w-5xl gap-6 sm:grid-cols-3">
			{
				city.booking.map((step, i) => (
					<div class="tile relative rounded-sm">
						<span class="font-display text-5xl leading-none font-semibold text-gold-500/60">{String(i + 1).padStart(2, '0')}</span>
						<p class="mt-4 text-sm leading-relaxed text-pine-800/80">{step}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- Nearby areas -->
	<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-24">
		<div class="rounded-sm border border-gold-500/30 bg-cream-50 p-8 sm:p-12">
			<p class="eyebrow">Nearby Areas</p>
			<h2 class="mt-3 font-serif text-3xl font-bold text-pine-900 sm:text-4xl">
				Santa across the Niagara Region
			</h2>
			<p class="mt-5 max-w-3xl leading-relaxed text-pine-800/80">{city.nearby}</p>
			<p class="mt-8 text-sm leading-relaxed text-pine-800/70">
				Hire Santa Claus in Niagara by visiting the{' '}
				<a href="/" class="font-semibold text-gold-700 underline decoration-gold-400/50 underline-offset-4 hover:decoration-gold-300">home page</a>, or explore the full list of communities below:
			</p>
			<ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
				{
					others.map((name) => {
						const other = cities.find((c) => c.name === name)!;
						return (
							<li>
								<a
									href={`/santa-claus-for-hire/${other.slug}/`}
									class="inline-flex items-center gap-2 text-sm font-semibold text-pine-800 transition-colors hover:text-gold-700"
								>
									<span class="h-px w-4 bg-gold-500/60" />
									Hire a Santa in {name}
								</a>
							</li>
						);
					})
				}
			</ul>
		</div>
	</section>

	<!-- FAQ -->
	<section class="mx-auto max-w-4xl px-5 pb-20 sm:px-8 lg:pb-24">
		<div class="mx-auto max-w-2xl text-center">
			<p class="eyebrow">Good to Know</p>
			<h2 class="mt-3 font-serif text-3xl font-bold text-pine-900 sm:text-4xl">
				Santa in {city.name}: frequently asked questions
			</h2>
		</div>
		<div class="mt-12 space-y-4">
			{
				city.faqs.map((faq) => (
					<div class="tile rounded-sm">
						<h3 class="font-serif text-lg font-bold text-pine-900">{faq.q}</h3>
						<p class="mt-2 text-sm leading-relaxed text-pine-800/75">{faq.a}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- Final CTA -->
	<section class="plaid relative overflow-hidden py-16">
		<div class="relative mx-auto flex max-w-6xl flex-col items-center justify-between gap-8 px-5 text-center sm:px-8 lg:flex-row lg:text-left">
			<div>
				<p class="text-[11px] font-semibold tracking-[0.32em] text-gold-300 uppercase">Ready for Holiday Magic?</p>
				<h2 class="mt-2 font-serif text-3xl font-bold text-cream-50 sm:text-4xl">
					Book Santa in {city.name}
				</h2>
				<p class="mt-3 max-w-xl text-sm leading-relaxed text-cream-100/80">
					Call <a href={contact.phoneHref} class="font-semibold text-gold-300 underline decoration-gold-400/50 underline-offset-4 hover:decoration-gold-300">{contact.phoneDisplay}</a> or
					email <a href={contact.emailHref} class="font-semibold text-gold-300 underline decoration-gold-400/50 underline-offset-4 hover:decoration-gold-300">{contact.email}</a> to check availability for your date.
				</p>
			</div>
			<a href="/contact/" class="btn shrink-0 rounded-sm border border-pine-950/30 bg-pine-950 text-gold-300 hover:-translate-y-0.5 hover:bg-pine-900">
				Request a Booking
			</a>
		</div>
	</section>
</Layout>
