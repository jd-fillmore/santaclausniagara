---
// Lightweight canvas-based snowfall overlay.
---

<canvas id="snow-canvas" class="pointer-events-none fixed inset-0 z-[100]" aria-hidden="true"></canvas>

<script>
	const canvas = document.getElementById('snow-canvas');
	const ctx = canvas.getContext('2d');
	const reduced =
		window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const DPR = Math.min(window.devicePixelRatio || 1, 2);

	let flakes = [];
	let w = 0;
	let h = 0;

	function resize() {
		w = window.innerWidth;
		h = window.innerHeight;
		canvas.width = Math.floor(w * DPR);
		canvas.height = Math.floor(h * DPR);
		canvas.style.width = `${w}px`;
		canvas.style.height = `${h}px`;
		ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
	}

	function desiredCount() {
		return Math.min(140, Math.floor(w / 9));
	}

	function makeFlake(initial) {
		return {
			x: Math.random() * w,
			y: initial ? Math.random() * h : -12,
			r: 0.8 + Math.random() * 2.4,
			fall: 0.55 + Math.random() * 1.15,
			sway: Math.random() * Math.PI * 2,
			swaySpeed: 0.008 + Math.random() * 0.02,
			opacity: 0.35 + Math.random() * 0.5,
		};
	}

	function init() {
		flakes = Array.from({ length: desiredCount() }, () => makeFlake(true));
	}

	function draw() {
		ctx.clearRect(0, 0, w, h);
		for (const f of flakes) {
			f.y += f.fall;
			f.sway += f.swaySpeed;
			f.x += Math.sin(f.sway) * 0.4;
			if (f.y > h + 14) {
				Object.assign(f, makeFlake(false), { x: Math.random() * w });
			}
			ctx.beginPath();
			ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(255, 255, 255, ${f.opacity.toFixed(3)})`;
			ctx.fill();
		}
	}

	function loop() {
		draw();
		requestAnimationFrame(loop);
	}

	resize();
	init();
	window.addEventListener('resize', resize);
	window.addEventListener('orientationchange', resize);

	if (reduced) {
		draw();
	} else {
		loop();
	}
</script>