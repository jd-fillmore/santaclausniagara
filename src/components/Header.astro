---
const path = Astro.url.pathname;

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About' },
	{ href: '/services/', label: 'Services' },
	{ href: '/gallery/', label: 'Gallery' },
	{ href: '/pricing/', label: 'Pricing' },
	{ href: '/contact/', label: 'Contact' },
];

function isActive(href) {
	if (href === '/') return path === '/';
	return path.startsWith(href);
}
---

<header class="sticky top-0 z-50">
	<div class="plaid-banner h-1.5 w-full"></div>
	<nav
		class="border-b border-gold-200/80 bg-cream-100/90 shadow-sm shadow-pine-950/5 backdrop-blur-md"
		aria-label="Main navigation"
	>
		<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 sm:px-8">
			<a href="/" class="group flex items-center gap-3" aria-label="Santa Claus Niagara — Home">
				<svg viewBox="0 0 40 52" class="h-12 w-9 shrink-0" aria-hidden="true">
					<rect x="16" y="3" width="8" height="5" rx="1.5" fill="#c9a227" />
					<circle cx="20" cy="27" r="17" fill="#1b3b2b" stroke="#c9a227" stroke-width="2" />
					<path d="M9 27 a11 11 0 0 1 22 0" fill="none" stroke="#c9a227" stroke-width="1" opacity="0.55" />
					<path
						d="M20 17 v20 M11 22 l18 10 M11 32 l18 -10"
						stroke="#fbf9f4"
						stroke-width="1.4"
						stroke-linecap="round"
						stroke-linejoin="round"
						fill="none"
					/>
				</svg>
				<span class="leading-tight">
					<span class="block font-serif text-xl font-bold tracking-wide text-pine-900 transition-colors group-hover:text-pine-700">
						Santa Claus
					</span>
					<span class="block text-[11px] font-semibold tracking-[0.42em] text-gold-600 uppercase">
						Niagara
					</span>
				</span>
			</a>

			<ul class="hidden items-center gap-7 lg:flex">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								class:list={[
									'relative text-[13px] font-semibold tracking-[0.08em] uppercase transition-colors hover:text-gold-700',
									isActive(item.href) ? 'text-gold-700' : 'text-pine-800',
								]}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.label}
								<span class="absolute -bottom-1 left-0 h-px w-full origin-left scale-x-0 bg-gold-500 transition-transform duration-300 group-hover:scale-x-100"></span>
							</a>
						</li>
					))
				}
			</ul>

			<div class="flex items-center gap-3">
				<a href="/contact/" class="btn btn-gold hidden rounded-sm sm:inline-flex">
					Book Santa
				</a>
				<button
					id="nav-toggle"
					type="button"
					class="inline-flex items-center justify-center rounded-sm border border-gold-500/40 p-2.5 text-pine-900 transition-colors hover:bg-gold-500/10 lg:hidden"
					aria-label="Toggle navigation menu"
					aria-expanded="false"
					aria-controls="nav-menu"
				>
					<span id="icon-open" class="block h-5 w-5" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
							<line x1="4" y1="7" x2="20" y2="7" />
							<line x1="4" y1="12" x2="20" y2="12" />
							<line x1="4" y1="17" x2="20" y2="17" />
						</svg>
					</span>
					<span id="icon-close" class="hidden h-5 w-5" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
							<line x1="6" y1="6" x2="18" y2="18" />
							<line x1="18" y1="6" x2="6" y2="18" />
						</svg>
					</span>
				</button>
			</div>
		</div>

		<div id="nav-menu" class="hidden border-t border-gold-200/80 bg-cream-50 lg:hidden">
			<ul class="space-y-1 px-5 py-4 sm:px-8">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								class:list={[
									'block rounded-sm px-3 py-2.5 font-serif text-lg font-semibold transition-colors',
									isActive(item.href)
										? 'bg-gold-500/10 text-gold-700'
										: 'text-pine-900 hover:bg-gold-500/5 hover:text-gold-700',
								]}
							>
								{item.label}
							</a>
						</li>
					))
				}
				<li class="pt-2">
					<a href="/contact/" class="btn btn-gold block w-full rounded-sm text-center">
						Book Santa
					</a>
				</li>
			</ul>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('nav-menu');
	const iconOpen = document.getElementById('icon-open');
	const iconClose = document.getElementById('icon-close');

	function setOpen(open) {
		menu.classList.toggle('hidden', !open);
		iconOpen.classList.toggle('hidden', open);
		iconClose.classList.toggle('hidden', !open);
		toggle.setAttribute('aria-expanded', String(open));
	}

	toggle.addEventListener('click', () => {
		setOpen(menu.classList.contains('hidden'));
	});

	menu.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setOpen(false));
	});

	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setOpen(false);
	});
</script>